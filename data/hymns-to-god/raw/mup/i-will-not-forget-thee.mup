1: 4ce; 8ca; db; 4ec+; ;
2: 4a-a; 8; ; 4; ;

	VS "E'en tho' the night be";
	VS "Tho' earth de-spise me,";
	VS "How sweet to hear the";
bar

//6
1: 8ec+; fd+; db; ec+; 4ca; ec;
2: 8ea; ; eg; ; 4a-a; ;

	VS "dark with-in the val-ley,";
	VS "tho' my friends for-sake me,";
	VS "bless-ed proc-la-ma-tion,";
bar
newscore

//7
1: 8df; eg; fa; fd+; 4ec+; ea;
2: 8da; ; ; ; 4ea; ec+;

	VS "Just be-yond is shin-ing";
	VS "I shall be re-mem-bered";
	VS "\"En-ter faith-ful ser-vant,";
bar

//8
1: 8eg; ea; eb; ec+; 2ea;
2: 8eb; ec+; ed+; ee+; 2a-c+;

	VS "an e-ter-nal day.";
	VS "in my home a-bove.";
	VS "wel-come home at last.\"";
dblbar
newscore


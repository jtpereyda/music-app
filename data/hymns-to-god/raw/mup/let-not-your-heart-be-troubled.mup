	VS 4; 4; "him, And";
	VS 4; 4; "guide, And";
	VS 4; 4; "road, Till";
bar
//6
1: 8af;;;;
2: 8c+f;;;;

	VS "words of sweet-est";
	VS "all his true dis-";
	VS "we thro' this way";
	VS "gives a bless-ed";
	VS "Je-sus comes to";

1: 4gb; ac+; gb; s;
2: 4ee+; ; ; s;

	VS "break the loaves";
	VS "bless the bread";
	VS "Word the truth";
//	VS "touch my eyes,";

invisbar

//6
1: 4s; ; ; gc+;
2: 4s; ; ; eb;

	VS "Be-";
	VS "By";
	VS "That";
//	VS "And";
bar

//7
1: 2fd+; ec+;
2: 2fb; fan;

	VS "side the";
	VS "Gal-i-";
	VS "sav-eth";
//	VS "make me";
bar

//8
1: 1db;
2: 1b-b;

	VS "sea;";
	VS "lee;";
	VS "me";
//	VS "see;";
bar

//9
1: 2df; 4eg; fa;
2: 2b-b; 4; b-d+;

	VS "With-in the";	//"Be-yond the"; //Original lyrics
	VS "Then shall all";
	VS "Give me to";
//	VS "Show me the";
bar

//10
1: 4ac+; gb; 2eg;
2: 4ee+; ; 2eb;

	VS "sa-cred page";
	VS "bond-age cease,";
	VS "eat and live";
//	VS truth con-cealed";
bar

//11
1: 2fb; 4fc+; ; 
2: 2db; 4can; ;

	VS "I seek Thee,";
	VS "All fet-ters";
	VS "With Thee a-";
//	VS "With-in Thy";
bar

//12
1 1: 1d+;
1 2: 2f slur; a&;
2: 1b-b;

	VS "Lord;";
	VS "fall;";
	VS "bove;";
//	VS "Word,";
bar

//13
1: 2ge+; 4gb; eg;
2: 2eb; 4ee+; eb;

	VS "My spir-it";
	VS "And I shall";
	VS "Teach me to";
//	VS "And in Thy";
bar

//14
1 1: 4f; ea; ec+; s;
1 2: 4e; s; ; ;
2: 4a-c+; ; ; s;

	VS "pants for Thee,";
	VS "find my peace,";
	VS "love Thy truth,";
//	VS "book re-vealed";

invisbar

//14
1: 4s; ; ; ea;
2: 4s; ; ; a-c+;

	VS "O";
	VS "My";
	VS "For";
//	VS "I";
bar

//15
1 1: 2f; db;
1 2: 2e; s;
2: 2b-b; b-a;

	VS "liv-ing";
	VS "all in";
	VS "Thou art";
//	VS "see the";
bar

//16

top

   title bold (19) "" "Is My Name Written There?" ""
   title (2)""
   title (11)"" "\f(TI)Rejoice because your names are written in heaven. - Lk. 10:20" ""
   title (11) "A\(flat) - 3 - SOL" "" ""
   title (13) "Mrs. Mary A. Kidder (arr.)" "" "Frank M. Davis"
 
footer

   title (11) "" "Public Domain" "HymnsToGod.org"
//==== FOR Letter ==========
score
	label=""
	packexp=0.0
	packfact=0.9
	pad=2
	vscheme=2f
	staffscale=1.0
	scoresep=6,10
	staffpad=0
	scorepad=0
	leftmargin=.750
	rightmargin=.750
	withfontfamily=palatino
	noteheads="isostri semicirc diam righttri norm rect pie"
//==========================
staffs=2
	time=3/4	
	key=4&


staff 2
	key=4&
	clef=bass


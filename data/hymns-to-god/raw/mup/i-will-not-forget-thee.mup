2 1: 8ca; eg; a; b; 4ac+; a;
2 2: 8s; ; a; ; 4s; a;

	VS "Noth-ing can mo-lest or";
	VS "On-ward will I go with";
	VS "All my trib-u-la-tions,";
bar

//4

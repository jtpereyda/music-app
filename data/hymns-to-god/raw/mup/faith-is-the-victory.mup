top

   title bold (19) "" "Faith Is The Victory" ""
   title (2) ""
   title (11)"" "\f(TI)For whatsoever is begotten of God overcometh the world: and this is" ""
   title (11)"" "\f(TI)the victory that hath overcome the world, even our faith. - 1 John 5:4" ""

   title (11)"F - 2 - SOL" "" ""  
   title (13) "John H. Yates" "" "Ira D. Sankey, 1891"

footer

   title (11) "" "Public Domain" "HymnsToGod.org"

//==== FOR LETTER SIZE==========


score

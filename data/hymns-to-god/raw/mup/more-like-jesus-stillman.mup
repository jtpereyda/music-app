	VS12 "faith-ful,";
	VS12 "heart-ed,";
	VS12 "ear-nest,";
	VS12 "dear-ly,";
invisbar

//8
1: 4s; 8; 4; 8df;
2: 4s; 8; 4; 8b-ng;

	VS "And";
	VS "With";
	VS "And";
	VS "For";
bar

//9
1: 8ce; cf; cg; 4ea; 8eg;
2: 8cg; ca; cb; 4cc+; 8cb;

	VS "ev-'ry com-mand o-";
	VS "sweet words of ten-der-";
	VS "souls to the Sav-iour";
	VS "Je-sus loves me, I";
bar

//10
1 1: 4.f tie; 4; 8r;
1 2: 4.f tie; 4; 8s;
2: 4.fa tie; 4; 8r;

	VS "bey.";
	VS "ness.";
	VS "bring.";
	VS "know.";
dblbar
newscore

//11
REFRAIN
1 1: 4fd+; 8ec+#; 8d+ bm; e+ ebm; 8ff+;
1 2: 4s; 8s; 4f; 8s;
2 1: 4s; 8s; 8b bm; c+ ebm; 8s;

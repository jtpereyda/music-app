1: 4eg; 8; fa; 4eg; 8ce; cg;
2: 4cc+; 8; ; 4; 8cg; eb&;

	VS "Naught will I fear as I";
bar

//14
1: 4cc+; fa; eg; gc+;
2: 4fa; fc+; cc+; ec+;

	VS "cross the val-ley,";
bar

//15
1 1: 4fd+; 8; ; 4ec+; b;
1 2: 4s; 8; ; 4; 8d bm; f ebm;
2 1: 4s; 8; ; 4; g;

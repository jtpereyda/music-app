//============================

//define macros

   //Lyrics
       define VS lyrics between 1&2: @
       define DSVS lyrics below 2: @

   //Chorus
       define CHORUS ital (16) above 1: 1 "Chorus"; @	
       define REFRAIN ital (16) above 1: 1 "Refrain"; @

   //Fermatas
       define SFERM(COUNT)
       mussym (9) above 1: COUNT "ferm"; @
       define BFERM(COUNT)
       mussym (9) below 2: COUNT "uferm"; @

   //Time Signature for projection files only
      define P1 [pad 5; =t]@
      define P2 [=s]@
      define TIME
         print (t.w - 2, t.y) "\f(newcentury bold)\s(16)4";
	 print (t.w - 2, t.y - 4) "\f(newcentury bold)\s(16)4";
	 print (t.w - 2, s.y) "\f(newcentury bold)\s(16)4";
	 print (t.w - 2, s.y - 4) "\f(newcentury bold)\s(16)4";
	 @

music


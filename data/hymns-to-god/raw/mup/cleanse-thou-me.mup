2: 4d+g; 8; 4; 8; 

	VS "In the heal-ing";
bar
//12
1: 4.bg slur; af;
2: 4.d+d tie; 4.;

	VS "flood,";
bar

//13
1: 4bg; 8; 4; 8c+g;
2: 4d+g; 8; 4; 8c+g;

	VS "Wash my soul from";
bar

//14
1: 4d+g; 8; 4.;
2: 4bg; 8; 4.;

	VS "ev-'ry stain";
bar

//15
1: 4c+e; 8ae; 4gd; 8fd;
2: 4c+c; 8; 4bd; 8ad;

	VS "In Thy pre-cious";
bar

//16

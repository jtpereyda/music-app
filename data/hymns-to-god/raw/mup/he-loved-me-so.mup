	VS "cause he loved me";
	VS "cause he loved me";
	VS "cause he loved me";
	VS "cause he loved me";
bar

//9
1: 2.ca; 4s;
2: 2.fa; 4s;

	VS "so!";
	VS "so!";
	VS "so.";
	VS "so.";
dblbar
newscore

//10
CHORUS
1 1: 2.s; 4a;
1 2: 2.s; 4r;
2 1: 2.s; 4c+;
2 2: 2.s; 4r;

	VS "He";
bar

//11

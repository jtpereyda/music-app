2: 4.cg; 4; 8eg;

	VS1 "Seems now some";
	VS1 "Je-sus in-";
	VS1 "\"Al-most\" can";
bar

//10
1: 4ec+; 8db; 4.;
2 1: 4g; 8; 4.;
2 2: 4g; 8; 4.;

	VS1 "soul to say,";

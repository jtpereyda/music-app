// ****************************************
//Letter Page Format

top
	title bold (19) "" "Cleanse Thou Me" ""
   	title (2)""
   	title (11) "" "\f(TI)Cleanse Thou me from secret faults. - Ps. 19:12" ""
   	title (11) "G - 2 - MI" "" ""
   	title (13) "Fanny J. Crosby" " " "Frank M. Davis"	

footer

   	title (11) "" "Public Domain" "HymnsToGod.org"

score
	label=""
	packexp = 0.0
	packfact = 0.8
	pad = 0
	vscheme = 2f
	staffsep = 23
	staffscale=1.0
	scoresep=6
	scorepad=0
	lyricsdist = 1
	rightmargin=.750
	leftmargin=.750
	withfontfamily=palatino
	noteheads = "isostri semicirc diam righttri norm rect pie"

staffs=2
	time=6/8
	key=1#

staff 2
	key=1#
	clef=bass

// ****************************************

music

//define macros

   //Lyrics
       define VS lyrics between 1&2: @
       define DSVS lyrics below 2: @

   //Chorus
       define CHORUS ital (13) above 1: 1 "Chorus"; @	
       define REFRAIN ital (13) above 1: 1 "Refrain"; @

   //Fermatas
       define SFT(COUNT)
       mussym (10) above 1: COUNT "ferm"; @

       define SFB(COUNT)
       mussym (10) below 1: COUNT "uferm"; @
 
       define BFT(COUNT)
       mussym (10) above 2: COUNT "ferm"; @

      define BFB(COUNT)
       mussym (10) below 2: COUNT "uferm"; @

   //Time Signature - Use on projection hymns only
      define P1 [pad 5; =t]@
      define P2 [=s]@
      define TIME
    	 print (t.w - 2, t.y) "\f(newcentury bold)\s(16)4";
	 print (t.w - 2, t.y - 4) "\f(newcentury bold)\s(16)4";
	 print (t.w - 2, s.y) "\f(newcentury bold)\s(16)4";
	 print (t.w - 2, s.y - 4) "\f(newcentury bold)\s(16)4";
	 @

//Define midi
	midi all: 0 "tempo=90";

//=============================

//1
1: 4bd; 8; 4; 8ac;
2 1: 4g; 8; 4; 8fd;
2 2: 4g; 8; 4; 8s;

	VS "<1. >-1|Cleanse Thou me from";
	VS "<2. >-1|Thou hast died that";	
	VS "<3. >-1|Make me pur-er,";

bar

//2
1: 4gb-; 8; 4.;
2: 4ge; 8; 4.ge;

	VS "se-cret sin,";
	VS "I might live,";
	VS "then, in heart,";
bar

//3
1: 4ge; 8; 4c+g; 8bg;
2: 4c+c; 8; 4c+e; 8d+g;

			
	VS "Cleanse Thou me, O";
	VS "Pre-cious is Thy";
	VS "Ev-er in me";

bar

//4
1: 4.bg slur; af;
2: 4.d+d tie; ;

	VS "Lord,";
	VS "name;";
	VS "shine;";
bar

//5
1: 4bg; 8; 4; 8c+g;
2: 4d+g; 8; 4; 8c+g;

	VS "Wash me in Thy";
	VS "Thou, O Christ, art";
	VS "Wit-ness may I";
bar

//6
1: 4d+g; 8; 4.;
2: 4bg; 8; 4.;

	VS "pre-cious blood,";
	VS "all in all,";
	VS "have with-in";
bar

//7
1: 4c+e; 8ae; 4gd; 8fd;
2: 4c+c; 8; 4bd; 8ad;

	VS "Save me by Thy";
	VS "Al-ways just the";
	VS "That I'm whol-ly";
bar

//8
1: 4.d~a slur; 4dg; 8r;
2: 4.c+d slur; 4bg; 8r;

	VS "word.";
	VS "same.";
	VS "Thine.";
dblbar

//9
CHORUS
1: 4bg; 8gd; 4.bg;
2: 4d+g; 8bg; 4.d+g;

	VS "Cleanse Thou me,";
bar

//10

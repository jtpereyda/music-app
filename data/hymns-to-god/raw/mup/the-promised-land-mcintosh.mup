1 2: 4fa; f; eg; ;
2 1: 4s; 8c+bm; a ebm; 4s; ;
2 2: 4cc+; c; cc+; cb;

	VS12 "my pos-ses-sions";
	VS12 "scat-ters night a-";
//	VS12 "felt and feared no";
	VS12 "in His bo-som";
bar

//10	
1 1: 2.f; 4s;
1 2: 2.f; 4s;
2: 2.fa; 4s;

	VS "lie.";
	VS "way.";
//	VS "more.";
	VS "rest?";

dblbar
newscore

REFRAIN

//11

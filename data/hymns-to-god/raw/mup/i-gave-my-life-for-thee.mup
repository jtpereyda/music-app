1 1: 4s; 8g; 8b bm; a; b ebm;
1 2: 4eg; 8g; 4f; 8;
2: 4gc+; 8ge+; 4gd+; 8gd+;

	VS12 "quick-end from the";
	VS12 "wan-derings sad and";
	VS12 "res-cue thee from";
	VS12 "par-don and My";

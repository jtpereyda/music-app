1 2: 4d; 8.; 16; 4s; ;
2 1: 4fa; 8.; 16gb; 4a; 4a-a;
2 2: 4s; 8.; 16; 4a; s;

	VS "Lead me to Cal-va-";
	VS "Guard-ed Thee while Thou";
	VS "Lead me to Cal-va-";
	VS "Thou hast borne all for";
bar


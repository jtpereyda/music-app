//11
1: 4.s; 4s; 8ec+;
2: 4.s; 4s; 8cc+;

	VS "I";
	VS "I";
	VS "I've";
	VS "I";
bar

//12
1: 4fd+; 8; 8 bm; ec+; db ebm;
2 1: 4s; 8s; 8b bm; c+; d+ ebm;
2 2: 4gb; 8; 4g; 8;

	VS22 "gave, I gave My";
	VS22 "left, I left it";
	VS22 "borne, I've borne it";
	VS22 "bring, I bring rich";
bar


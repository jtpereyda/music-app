invisbar

//5
1 1: 8ec+; fbn; gb&; 2s; 8s;
2: 8cg; dg; ec+; 8s; ; ; ; ; 

	VS "He broke the";
	VS "By cru-el";
	VS "Be-tween two";
bar

//6
1: 4fa; fb; fa; eg;
2: 4fc+; fd+; fc+; cb;

	VS "bonds of sin and";
	VS "man with spear His";
	VS "thieves they cru-ci-";
bar

//7
1: 8df; ; ; eg; fa; 8s; ; ;
2: 8da; ; ; cc+; fc+; 8s; ; ;

	VS "set the cap-tive free,";
	VS "side was pierced and bled,";
	VS "fied the Son of God,";
invisbar
SIGN(3.5);
//7
1: 8s; ; ; ; ; r; 4;
2 1: 8s; ; ; ; ; r; 4;
2 2: 8s; ; ; ; ; a; g; f;

	VS "";
	VS22 "He bore it";
bar

//8
1: 8r; gb; r; eb; r; fb; r; gb;
2 1:8r; c+; r; c+; r; c+; r; c+;
2 2: 4e; c; d; e;

	VS "all that I might";
	VS22 "all that I might";
bar

//9
FINE(3);
1: 8r; 16fa; ; 8fb; ; fa; 4.s; 
2 1: 8r; 16c+; ; 8d+; ; 8c+; 4.s;
2 2: 2f tie; 8f; 4.s;


	VS "in His pres-sence live.";
	VS22 "live.< ____________________>";
dblbar
newscore

REFRAIN

//10
1: 8ac+; bd+; ac+; 2s; 8s;
2: 8r; 4r; 2s; 8s;

	VS "He bore it";

bar

//10
1: 4fa; ; 8; bd+; ac+; gb;
2: 8fc+; ; ff+; fd+; fc+; r; 4;

	VS "all that I might see His";
	VS21 "Je-sus bore it all,";
bar

//11
1 1: 4fa; eg; 8f; s; ; ;
1 2: 4s; ; 8f; s; 4;
2: 8fc+; ; cb; ; da; s; ; ;

	VS "shin-ing face,";
	VS21 "see His shin-ing face,";
invisbar
newscore

1: 4s; ; 8; r; 4;
2 1: 8s; ; ; ; ; r; 4;
2 2: 8s; ; ; ; ; c; d; c;

	VS22 "He bore it";
bar

//12
1: 8eb; fb; gb; fb; eb; r; 4;
2 1: 8c+; d+; e+; d+; c+; r; 4;

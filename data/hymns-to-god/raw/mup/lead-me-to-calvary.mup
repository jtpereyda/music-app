1 2: 4s; 8.; 16d; 4s; ;
2: 4da; 8.dg; 16df; 4fa; da;

	VS "Thine shall the glo-ry";
	VS "Ten-der-ly mourn'd and";
	VS "Come with a gift to";
	VS "Dai-ly my cross for";
bar


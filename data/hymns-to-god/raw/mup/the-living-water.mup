       define SFERM(COUNT)
       mussym (9) above 1: COUNT "ferm";
       @
       define BFERM(COUNT)
       mussym (9) below 2: COUNT "uferm";
       @

   //Time Signature - Use on projection hymns only
      define P1 [pad 5; =t]@
      define P2 [=s]@
      define TIME

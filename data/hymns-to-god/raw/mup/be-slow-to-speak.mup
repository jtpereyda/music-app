top

   title bold (19) "" "Be Slow To Speak" ""
   title (2)""
   title (11)"" "\f(TI)let every man be swift to hear, slow" ""
   title (11)"" "\f(TI)to speak, slow to wrath: - Jms. 1:19" ""
   title (13) "Kate Ulmer" " " "M. L. McPhail, 1907"	
 
bottom

   title (11) "" "Public Domain" "HymnsToGod.org"

score

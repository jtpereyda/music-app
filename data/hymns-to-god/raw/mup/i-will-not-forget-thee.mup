1 2: 8s; ; ; ; 4e slur; d&;
2 1: 8b; a; gb; fb;2 eg;
2 2: 8a; ; s; ; 2;

	VS "turn my soul a-way;";
	VS "songs of joy and love,";
	VS "all my sor-rows past,";
bar

// ****************************************

//define macros

   //Lyrics
       define VS lyrics between 1&2: @
       define DSVS lyrics below 2: @

   //Chorus
       define CHORUS ital (13) above 1: 1 "Chorus"; @	
       define REFRAIN ital (13) above 1: 1 "Refrain"; @

   //Fermatas
       define SFERM(COUNT)
       mussym (9) above 1: COUNT "ferm";
       @
       define BFERM(COUNT)
       mussym (9) below 2: COUNT "uferm";
       @

music

midi all: 0 "tempo=90";

//1
1: 8c+e; 8c+e; 8bndn; 8c+e; 4ac; 4ec;
2: 8aa-; 8aa-; 8aa-; 8aa-; 4ea-; 4aa-;


			VS "<1. >-1|Oh, what pain and sor-row,";
			VS "<2. >-1|Oh, re-mem-ber, Je-sus";
			VS "<3. >-1|Love that thinks no e-vil,";
			VS "<4. >-1|Make your life a bless-ing,";
bar
//2
1: 8fd; 8af; 8af; 8fd; 2ec;
2: 8ad; 8d+d; 8d+d; 8ad; 2aa-;

			VS "bit-ter-ness and woe,";
			VS "ev-'ry word doth hear,";
			VS "dwell-ing in the heart,";
			VS "fol-low aft-er peace,";
bar
//3
1: 8fd; 8af; 8af; 8bf&; 8c+e; 8ae; 8d+e; 8c+e;
2: 8ad; 8d+d; 8ad; 8ad; 8aa-; 8ac; 8gb-; 8aa-;

			VS "E-vil speak-ing caus-eth in this";
			VS "By His Ho-ly Spir-it He is";
			VS "Will its bless-ed sweet-ness to the";
			VS "Pa-tient-ly pur-sue it from all";
bar
//4
1: 4bdn; 4fd; 2bd&;
2: 4fb-; 4bb-; 2ge;

			VS "world be-low;";
			VS "ev-er near;";
			VS "life im-part;";
			VS "e-vil cease;";
bar
//5
1: 8c+e; 8c+e; 8bndn; 8c+e; 4ac; 4ec;
2: 8aa-; 8aa-; 8aa-; 8aa-; 4ea-; 4aa-;
mussym (9) above 1: 1 "sign";

			VS "Lov-ing hearts are bro-ken,";
			VS "Think how much He suf-fered";
			VS "Then each tho't and ac-tion";
			VS "Scat-t'ring deeds of kind-ness";
			DSVS "<\f(TX)D.S.\f(TR) - >-1|He will ev-er help you,";
bar
//6
1: 8fd; 8af; 8af; 8d+f&; 2c+e;
2: 8ad; 8d+d; 8d+d; 8ad; 2aa-;

			VS "dear-est hopes de-stroyed";
			VS "ere you wound Him more,";
			VS "by its pow'r con-trolled";
			VS "speak-ing words of love,";
			DSVS "if His aid you seek,";

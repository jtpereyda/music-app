	VS "faith-ful fol-lw'r";
bar

//16
FST(3)
FBB(3)
1: 4ad+; 8ac+ bm; 8gb ebm; 4fa; 4s;
2: 4fd+; gd+; dd+; 4s;

	VS21 "I would be,";

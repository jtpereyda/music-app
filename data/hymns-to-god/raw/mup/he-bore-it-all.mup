bar


//15
DS(3.5)
1 1: 4fa; g; 8; 4.s;
1 2: 4s; 4f; 8; 4.s;
2: 8fc+; ; gbn; ; ; 4.s;

	VS "took my place,";
	VS21 "free-ly took my place,";
endbar

//==== FOR LETTER SIZE====================


score
	label=""
	packexp=0.0
	packfact=0.9
	pad=2
	vscheme=2f
	staffscale=.95
	scoresep=6
	staffpad=0
	scorepad=0
	leftmargin=.750
	rightmargin=.750
	withfontfamily=palatino
	noteheads="isostri semicirc diam righttri norm rect pie"

//=========================
staffs=2
	time=6/4
	key=3&


staff 2
	key=3&
	clef=bass

//=========================

top

   title bold (19) "" "Where We'll Never Grow Old" ""
   title (2)""
   title (11) "" "\f(TI)and he shall wipe away every tear from their eyes; and death" ""
   title (11) "" "\f(TI)shall be no more; neither shall there be mourning, nor crying" ""
   title (11) "" "\f(TI)nor pain, any more: the first things are passed away. - Rev. 21:4" ""

   title (11) "E \(flat) - 2 - DO" "" ""
   title (11) "James C. Moore" "" "James C. Moore, 1914"
 
footer

   title (11) "" "Public Domain" "HymnsToGod.org"


//=========================

music

//define macros

   //Lyrics
     //Lyrics Between Staffs
         define VS lyrics between 1&2: @
         define VS11 lyrics between 1&2 using 1: @
         define VS12 lyrics between 1&2 using 1 2: @
         define VS21 lyrics between 1&2 using 2 1:@
         define VS22 lyrics between 1&2 using 2 2:@ 

     //Lyrics Below Bass Staff    
         define BVS lyrics below 2: @
         define BVS11 lyrics below 2 using 1: @
         define BVS12 lyrics below 2 using 1 2: @
         define BVS21 lyrics below 2 using 2 1:@
         define BVS22 lyrics below 2 using 2 2:@ 

     //Text - Above Staff
         define CHORUS ital (13) above 1: 1 "Chorus"; @	
         define REFRAIN ital (13) above 1: 1 "Refrain"; @
         define RALL ital (13) above 1: 1 "Rall."; @
	define EFFECT ital (13) above 1: 1 "Effectively"; @

     //Fermatas
         define FST(COUNT)
           mussym (10) above 1: COUNT "ferm"; @
        define FSB(COUNT)
          mussym (10) below 1: COUNT "uferm"; @
         define FBT(COUNT)
          mussym (10) above 2: COUNT "ferm"; @
        define FBB(COUNT)
          mussym (10) below 2: COUNT "uferm"; @

     //Note Accents
        define AST(COUNT)
          mussym (10) above 1: COUNT "acc_gt"; @
        define ASB(COUNT)
          mussym (10) below 1: COUNT "acc_gt"; @
        define ABT(COUNT)
          mussym (10) above 2: COUNT "acc_gt"; @
        define ABB(COUNT)
          mussym (10) below 2: COUNT "acc_gt"; @

     //Repeats
        define RIT(COUNT)
           ital (13) above 1: COUNT "rit."; @
        define FINE(COUNT)
           ital (13) above 1: COUNT "fine"; @
        define SIGN(COUNT)
	   mussym (10) above 1: COUNT "sign"; @
        define DS(COUNT)
	  ital (13) above 1: COUNT "D. S."; @

//=========================

// set midi
	midi all: 0 "tempo=105";


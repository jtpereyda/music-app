//==========================

top

   title bold (19) "" "He Leadeth Me" ""
   title (2)""
   title (11)"" "\f(TI)...I am Jehovah thy God, who teacheth thee to profit, who leadeth" ""
   title (11)"" "\f(TI)thee by the way that thou shouldest go. - Is. 48:17" ""
   title (11) "D - 4 - SOL" "" ""
   title (13) "Joseph H. Gilmore, 1861" "" "William B. Bradbury, 1864"
 
footer

   title (11) "" "Public Domain" "HymnsToGod.org"
   
//==== FOR LETTER SIZE==========


score
	label=""
	packexp=0.0
	packfact=0.9
	pad=2
	vscheme=2f
	staffscale=.96
	scoresep=10
	staffpad=0
	scorepad=0
	leftmargin=.750
	rightmargin=.750
	withfontfamily=palatino
	noteheads="isostri semicirc diam righttri norm rect pie"

//==========================

staffs=2
	time=4/4	
	key=d


staff 2
	key=d
	clef=bass

//==========================

music

//define macros

   //Lyrics
     //Lyrics Between Staffs
         define VS lyrics between 1&2: @
         define VS1 lyrics between 1&2 using 1: @
         define VS12 lyrics between 1&2 using 1 2: @
         define VS21 lyrics between 1&2 using 2 1:@
         define VS22 lyrics between 1&2 using 2 2:@ 

     //Lyrics Below Bass Staff    
         define BSV lyrics below 2: @
         define BSV1 lyrics below 2 using 1: @
         define BSV12 lyrics below 2 using 1 2: @
         define BSV21 lyrics below 2 using 2 1:@
         define BSV22 lyrics below 2 using 2 2:@ 

   //Chorus
       define CHORUS ital (12) above 1: 1 "Chorus"; @	
       define REFRAIN ital (12) above 1: 1 "Refrain"; @

   //Fermatas
       define FST(COUNT)
       mussym (10) above 1: COUNT "ferm"; @

       define FSB(COUNT)
       mussym (10) below 1: COUNT "uferm"; @
 
       define FBT(COUNT)
       mussym (10) above 2: COUNT "ferm"; @

       define FBB(COUNT)
       mussym (10) below 2: COUNT "uferm"; @

   //Repeats
      define RIT(COUNT)
           ital (12) above 1: COUNT "rit."@
      define FINE(COUNT)
           ital (12) above 1 :COUNT "fine"@
      define SIGN(COUNT)
	   mussym (10) above 1: COUNT "sign";@

//=========================

// set midi
	midi all: 0 "temp=95";

//=========================

//Verse 1

//1
1: 2.s; 4fa;
2: 2.s; 4da;

	VS "<1. >-1|He";
	VS "<2. >-1|Some-";
	VS "<3. >-1|Lord,";
	VS "<4. >-1|And";
bar

//2
> below 1: 1 til 2;
1: 4.df; 8a-e; 4a-d; 4da;
2: 4.da; 8dg; 4df; 4df;

	VS "lead-eth me! O,";
	VS "times 'mid scenes of";
	VS "I would clasp thy";
	VS "when my task on";
bar

//3
1: 4db; dg; ; s;
2 1: 4g; gb; ; s;
2 2: 4g; 2.s;

	VS "bless-ed thought,";
	VS "deep-est gloom,";
	VS "hand in mine,";
	VS "earth is done,";
invisbar

1 1: 2.s; 4gb;
1 2: 2.s; 4s;
2 1: 2.s; 4gd+;
2 2: 2.s; 4s;


	VS "O";
	VS "Some-";
	VS "Nor";
	VS "When";
bar

//4
1 1:4.fa; 8df; 4; 8e bm; 8d ebm;
1 2: 2.s; 8c bm; 8d ebm;
2 1: 2.s; 8g bm; 8f ebm;
2 2: 4.dd+; 8da; 4; 4d;

	VS1 "words with heav-en-ly";
	VS22 "times where E-den's";
	VS22 "ev-er mur-mor";
	VS22 "by thy grace, the";
bar

//5
FST(3)
FBT(3)
1: 4df; ; ce; 4s;
2: 4a-a; ; ; 4s;

	VS "com-fort frought";
	VS "bow-ers bloom,";
	VS "nor re-pine\(emdash)";
	VS "vic-tory's won,"; 
invisbar

1: 4ca; 2.s;
2: 4a-a; 2.s;

	VS "What-";
	VS "By";
	VS "Con-";
	VS "E'en";
bar

//6
1: 4.df; 8a-e; 4a-d; 4da;
2: 4.da; 8dg; 4df; ;

	VS "e'er I do, where-";
	VS "wa-ters still, o'er";
	VS "tent, what-ev-er";
	VS "death's cold wave I";
bar

//7
FST(3)
FBT(3)
1 1: 4db; g; gd+; 4s;
1 2: 4s; 4g; 2s;
2 1: 4g; gb; ; s;

	VS "e'er I be,";
	VS "trou-bled sea\(emdash)";
	VS "lot I see,";
	VS "will not flee,";
invisbar

1 1: 2.s; 8c+ bm; 8b ebm;
1 2: 2.s; 4g;
2 1: 1s;
2 2: 2.s; 4gd+;

	VS12 "Still";
	VS12 "Still";
	VS12 "Since";
	VS12 "Since";
bar

//8
1: 4fa; df; 8df bm; ce ebm; b-d bm; 8ce ebm;
2: 4dd+; da; b-b; b-f;

	VS21 "tis God's hand that";
	VS21 "tis his hand that";
	VS21 "'tis my God that";
	VS21 "God thro' Jor-dan";
bar

//9
> above 1: 1 til 3;
1 1: 4.df; 8ce; 4d; 4s;
1 2: 4.s; 8; 4d; 4s;
2: 4.a-a; 8a-g; 4df; 4s;

	VS21 "lead-eth me.";
	VS21 "lead-eth me.";
	VS21 "lead-eth me.";
	VS21 "lead-eth me.";
dblbar
newscore

//10
REFRAIN
boldital dyn above 1: 1 "f";
1: 2.s; 4fa;
2: 2.s; 4da;

	VS "He";
bar

//11
1: 4fa; fd+; ec+; ae+;
2 1: 4dd+; fa; 4a; 4gc+;
2 2: 4s; ; a; s;

	VS "lead-eth me! He";
bar

//12
